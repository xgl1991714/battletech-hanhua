{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BATTLETECH汉化工具",
  "version": "1.0.1",
  "identifier": "com.moonstone.bt.hh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "localData": "./app-data"
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "BATTLETECH汉化工具",
        "width": 1000,
        "height": 563,
        "minWidth": 1000,
        "minHeight": 618,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MoonStone",
    "copyright": "© 2026 MoonStone. All Rights Reserved.",
    "category": "Utility",
    "shortDescription": "BATTLETECH汉化工具",
    "longDescription": "BATTLETECH汉化工具，支持原版（BT）与RogueTech（RT）汉化。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
